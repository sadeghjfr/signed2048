    <!-- About -->
    <string name="about_title">SIGNED 2048</string>
    <string name="about_ok">Ok</string>

    <string name="about_text">
    How to play: Swipe the tiles to combine numbers with the same sign or opposite signs to reach the target.\n\n
    Combining rules:\n\n
    Same sign, same number: They add together\n
    Example: 4 + 4 = 8  (produces +8)\n\n
    Same sign, same number (negative): They add together (more negative)\n
    Example: (-4) + (-4) = -8  (produces -8)\n\n
    Opposite signs, same absolute value: They cancel each other\n
    Example: (4-) + 4 = 0 (produces zero tile)\n\n
    Each move adds a new tile (+2, -2, +4, or -4) to the board.
    </string>

